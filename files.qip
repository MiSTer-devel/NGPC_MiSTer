# SYNTHESIS selects the altddio_out/altddio_in I/O-cell capture path in
# rtl/mem/sdram.sv. Quartus does not define it on its own; without it the
# `ifdef's fabric-clock simulation model is synthesized instead, and
# CAS_READ_CYCLES in sdram.sv is tuned against the I/O-cell path.
set_global_assignment -name VERILOG_MACRO "SYNTHESIS=1"

# TV80_REFRESH is required: without it tv80 has no R register and emits no
# refresh cycle, a silent accuracy loss rather than a build error.
set_global_assignment -name VERILOG_MACRO "TV80_REFRESH=1"

# EXPERIMENT, 2026-08-24 -- the K2GE dot-resolve burst (agents/CHANGES.md of
# that date).  k2ge_scanout resolves the 160 visible pixels one per dot across
# hdot 60..219 instead of every third dot across 0..477, so a mid-line palette
# write lands where hardware puts it.  These two lines are the ONLY way the
# parameter reaches Quartus -- it is `ifdef-gated so that a build cannot pick it
# up by accident, which also means a build cannot pick it up on purpose without
# them.  Remove both to build the shipped scanout timing.
# Requires P_BG_LINE_LATCH = 0 in rtl/video/k2ge_palette.sv, which is the
# current default.  VERIFY after any build: NGPC.map.rpt must show
# P_DOT_BURST ; 1 for k2ge_scanout:u_scanout.
set_global_assignment -name VERILOG_MACRO "NGPC_DOT_BURST=1"
set_global_assignment -name VERILOG_MACRO "NGPC_BURST_START=60"
